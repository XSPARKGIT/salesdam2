---
import DevLayout from '../../layouts/DevLayout.astro';

const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const sessionSchema = esc(`import mongoose from 'mongoose';

const sessionSchema = new mongoose.Schema({
  sessionId:      { type: String, required: true, unique: true, index: true },
  userId:         { type: mongoose.Schema.Types.ObjectId, ref: 'User', default: null },
  tenantId:       { type: mongoose.Schema.Types.ObjectId, ref: 'Tenant', default: null },
  data:           { type: mongoose.Schema.Types.Mixed, default: {} },
  expiresAt:      { type: Date, required: true, index: true },
  lastAccessedAt: { type: Date, default: Date.now },
  ipAddress:      { type: String },
  userAgent:      { type: String },
}, { timestamps: true });

// MongoDB TTL: auto-removes expired documents
sessionSchema.index({ expiresAt: 1 }, { expireAfterSeconds: 0 });
sessionSchema.index({ userId: 1 });

export default mongoose.model('Session', sessionSchema);`);

const storeCode = esc(`import session from 'express-session';
import Session from '../models/Session.js';
const { Store } = session;

class MongoSessionStore extends Store {
  constructor(options = {}) {
    super(options);
    this.maxAge = options.maxAge || 86400000;  // 24h default
    this.touchAfter = options.touchAfter || 3600000;
  }

  // Load session by ID
  get(sid, cb) {
    Session.findOne({ sessionId: sid, expiresAt: { $gt: new Date() } })
      .then(doc => {
        if (!doc) return cb(null, null);
        const sess = Object.assign({}, doc.data || {});
        if (doc.userId)   sess.userId   = doc.userId.toString();
        if (doc.tenantId) sess.tenantId = doc.tenantId.toString();
        cb(null, sess);
      })
      .catch(err => cb(err));
  }

  // Create or update session
  set(sid, sess, cb) {
    const expiresAt = new Date(Date.now() + this.maxAge);
    const update = { sessionId: sid, data: sess, expiresAt, lastAccessedAt: new Date() };
    if (sess.userId)   update.userId   = sess.userId;
    if (sess.tenantId) update.tenantId = sess.tenantId;
    Session.findOneAndUpdate({ sessionId: sid }, update, { upsert: true, new: true })
      .then(() => cb(null)).catch(err => cb(err));
  }

  // Delete a session
  destroy(sid, cb) {
    Session.deleteOne({ sessionId: sid })
      .then(() => cb(null)).catch(err => cb(err));
  }

  // Refresh TTL (throttled by touchAfter)
  touch(sid, sess, cb) {
    const now = Date.now();
    Session.findOneAndUpdate(
      { sessionId: sid, lastAccessedAt: { $lt: new Date(now - this.touchAfter) } },
      { expiresAt: new Date(now + this.maxAge), lastAccessedAt: new Date() }
    ).then(() => cb(null)).catch(err => cb(err));
  }
}

export default MongoSessionStore;`);

const sessionConfig = esc(`// config/session.js
import MongoSessionStore from './sessionStore.js';

const maxAge = parseInt(process.env.SESSION_MAX_AGE) || 86400000;

export default {
  name:             'crm.sid',
  secret:           process.env.SESSION_SECRET || 'change-in-production',
  resave:           false,
  saveUninitialized: false,
  store:            new MongoSessionStore({ maxAge, touchAfter: 3600000 }),
  cookie: {
    httpOnly: true,
    secure:   process.env.NODE_ENV === 'production',
    sameSite: process.env.NODE_ENV === 'production' ? 'strict' : 'lax',
    maxAge,
  },
};`);

const authMiddleware = esc(`// middleware/auth.js
const requireAuth = async (req, res, next) => {
  try {
    // 1. API Key auth (for integrations)
    const apiKey = req.headers['x-api-key'];
    if (apiKey) return authenticateApiKey(req, res, next, apiKey);

    // 2. Cookie present?
    if (!req.session?.userId) {
      throw new AppError('Authentication required.', 401);
    }

    // 3. Validate cookie against Session collection in MongoDB.
    //    Prevents forged cookies and respects server-side revocation.
    const dbSession = await Session.findOne({
      sessionId:  req.sessionID,          // signed session ID from cookie
      userId:     req.session.userId,     // must match what was stored at login
      expiresAt:  { $gt: new Date() },    // must not be expired
    });
    if (!dbSession) {
      req.session.destroy(() => {});
      throw new AppError('Session expired or invalid. Please log in again.', 401);
    }

    // 4. Load user
    const user = await User.findById(req.session.userId).populate('role');
    if (!user) { req.session.destroy(() => {}); throw new AppError('User not found.', 401); }
    if (user.status !== 'active') throw new AppError('Account deactivated.', 403);
    if (user.isLocked())          throw new AppError('Account locked.', 403);

    const tenantId = req.session.tenantId || req.headers['x-tenant-id'];
    if (!tenantId) throw new AppError('No active tenant.', 400);

    req.user     = user;
    req.tenantId = tenantId.toString();

    // 5. Touch session + user activity (non-blocking)
    Session.updateOne({ sessionId: req.sessionID }, { lastAccessedAt: new Date() }).catch(() => {});
    User.updateOne({ _id: user._id }, { lastActivity: new Date() }).catch(() => {});
    next();
  } catch (err) { next(err); }
};`);

const sessionLifecycle = esc(`
Frontend (React, port 3000)          Vite Dev Proxy             Backend (Express, port 5001)
─────────────────────────────────    ──────────────────────     ──────────────────────────────

1. POST /api/auth/login
   axios({ withCredentials: true })
         ──────────────────────────► forwards to :5001 ──────► authController.login()
                                                                  └─ bcrypt verify
                                                                  └─ session.userId = user._id
                                                                  └─ session.tenantId = ...
                                                                  └─ await saveSession()  ← waits for MongoDB write
                                                                  └─ res.json({ user, tenant })
                                     ◄── Set-Cookie: crm.sid ──
         ◄─── Set-Cookie forwarded ──
   Browser stores crm.sid for localhost

2. Subsequent request: GET /api/auth/me
   Cookie: crm.sid=... (auto-attached)
         ──────────────────────────► forwards + cookie ──────► requireAuth middleware
                                                                  └─ Session.findOne({ sessionId, userId })
                                                                       ↑ validates cookie against DB
                                                                  └─ User.findById(session.userId)
                                                                  └─ req.user = user
                                                                  └─ next() → controller
         ◄─────────────────────────────────────────────────────────── 200 + user data

3. Logout: POST /api/auth/logout
         ──────────────────────────► forwards ───────────────► authController.logout()
                                                                  └─ req.session.destroy()
                                                                       └─ MongoSessionStore.destroy()
                                                                            └─ Session.deleteOne({ sessionId })
                                                                  └─ res.clearCookie('crm.sid')
`);

const registerFlow = esc(`POST /api/auth/register
─────────────────────────────────────────────
1. Validate: firstName, lastName, email, password, tenantName
2. Check tenantName uniqueness (case-insensitive)
3. Auto-generate tenantSlug from tenantName
4. Create Tenant document (with plan, phone, debitOrderDay)
5. seedDefaultRoles(tenant._id) → creates superuser/admin/user roles
6. Create User (systemRole: 'superuser', emailVerified: true)
7. Set req.session.userId + req.session.tenantId
8. Optionally kick off AI onboarding in background
9. Return { user, tenant }`);

const loginFlow = esc(`POST /api/auth/login
─────────────────────────────────────────────
1. Find user by email (+ optional tenantId)
2. Check account not locked (failed login counter)
3. bcrypt.compare(password, user.password)
4. Check user.status === 'active'
5. Check tenant.status === 'active'
6. Reset failed login counter
7. req.session.userId    = user._id.toString()
   req.session.tenantId  = tenantId.toString()
   req.session.ipAddress = req.ip
   req.session.userAgent = req.headers['user-agent']
8. await saveSession(req.session)
   ↑ Waits for MongoSessionStore.set() to write the Session
     document to MongoDB BEFORE the response is sent.
     This prevents the race condition where /auth/me arrives
     before the session exists in the DB.
9. Set-Cookie: crm.sid=<signed-session-id>; HttpOnly; SameSite=Lax
10. Audit log: action 'login'
11. Return { user, tenant }`);

const apiKeyCode = esc(`// API Key authentication flow
const authenticateApiKey = async (req, res, next, rawKey) => {
  const prefix  = rawKey.substring(0, 12);
  const apiKeys = await ApiKey.find({ keyPrefix: prefix, isActive: true }).select('+keyHash');

  const validKey = apiKeys.find(k => k.verifyKey(rawKey));
  if (!validKey) throw new AppError('Invalid API key.', 401);
  if (validKey.expiresAt && validKey.expiresAt < new Date()) throw new AppError('API key expired.', 401);

  // IP whitelist check
  if (validKey.ipWhitelist?.length && !validKey.ipWhitelist.includes(req.ip)) {
    throw new AppError('IP not whitelisted.', 403);
  }

  const user = await User.findById(validKey.createdBy).populate('role');
  req.user        = user;
  req.tenantId    = validKey.tenantId.toString();
  req.apiKey      = validKey;
  req.isApiKeyAuth = true;

  // Update usage counter (non-blocking)
  ApiKey.updateOne({ _id: validKey._id }, { lastUsedAt: new Date(), $inc: { usageCount: 1 } }).catch(() => {});
  next();
};`);
---

<DevLayout
  title="Authentication — Developer Guide — Salesdam"
  description="How session-based authentication, the Session model, custom MongoSessionStore, and API key auth work in Salesdam."
>
  <h1>Authentication</h1>

  <p>
    Salesdam uses <strong>server-side session authentication</strong> backed by a custom
    <code>Session</code> Mongoose model — no third-party session store package is used.
    API keys provide an alternative authentication path for programmatic access.
  </p>

  <div class="info-box">
    <strong>Key decision:</strong> Sessions are stored in MongoDB using the app's own
    <code>Session</code> model and a hand-written <code>MongoSessionStore</code> class
    that implements the <code>express-session</code> <code>Store</code> interface.
    This replaces <code>connect-mongo</code>.
  </div>

  <h2>Session Model — <code>backend/models/Session.js</code></h2>

  <p>Each active user session is represented as a MongoDB document with TTL auto-deletion:</p>

  <pre><code set:html={sessionSchema}></code></pre>

  <h3>Session Fields</h3>
  <table class="doc-table">
    <thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td><code>sessionId</code></td><td>String</td><td>Unique session identifier (set by express-session), indexed</td></tr>
      <tr><td><code>userId</code></td><td>ObjectId → User</td><td>The authenticated user (null for unauthenticated sessions)</td></tr>
      <tr><td><code>tenantId</code></td><td>ObjectId → Tenant</td><td>Active workspace for this session</td></tr>
      <tr><td><code>data</code></td><td>Mixed</td><td>Full session payload (mirrors express-session object)</td></tr>
      <tr><td><code>expiresAt</code></td><td>Date</td><td>Expiry timestamp. MongoDB TTL index auto-deletes expired docs</td></tr>
      <tr><td><code>lastAccessedAt</code></td><td>Date</td><td>Updated on each request (throttled by <code>touchAfter</code>)</td></tr>
      <tr><td><code>ipAddress</code></td><td>String</td><td>Client IP, stored for security auditing</td></tr>
      <tr><td><code>userAgent</code></td><td>String</td><td>Browser / client identifier</td></tr>
    </tbody>
  </table>

  <h2>Custom Session Store — <code>backend/config/sessionStore.js</code></h2>

  <p>
    The <code>MongoSessionStore</code> class extends <code>express-session.Store</code> and
    implements all required methods using the <code>Session</code> model directly.
    No third-party packages needed.
  </p>

  <pre><code set:html={storeCode}></code></pre>

  <h3>Store Method Summary</h3>
  <table class="doc-table">
    <thead><tr><th>Method</th><th>Purpose</th></tr></thead>
    <tbody>
      <tr><td><code>get(sid, cb)</code></td><td>Load a session. Returns <code>null</code> if expired or not found</td></tr>
      <tr><td><code>set(sid, sess, cb)</code></td><td>Upsert session document. Hoists <code>userId</code>/<code>tenantId</code> to indexed top-level fields</td></tr>
      <tr><td><code>destroy(sid, cb)</code></td><td>Delete session (logout)</td></tr>
      <tr><td><code>touch(sid, sess, cb)</code></td><td>Refresh TTL, throttled by <code>touchAfter</code> (default 1h) to avoid excessive writes</td></tr>
      <tr><td><code>all(cb)</code></td><td>Return all active sessions (admin panel use)</td></tr>
      <tr><td><code>length(cb)</code></td><td>Count active sessions</td></tr>
      <tr><td><code>clear(cb)</code></td><td>Delete all sessions (emergency use)</td></tr>
    </tbody>
  </table>

  <h2>Session Configuration — <code>backend/config/session.js</code></h2>

  <pre><code set:html={sessionConfig}></code></pre>

  <h2>Authentication Middleware — <code>backend/middleware/auth.js</code></h2>

  <p>
    <code>requireAuth</code> is applied to all protected routes. It checks for an API key header
    first, then falls back to session auth.
  </p>

  <pre><code set:html={authMiddleware}></code></pre>

  <h3>Exported middleware</h3>
  <ul>
    <li><code>requireAuth</code> — Any authenticated user (session or API key)</li>
    <li><code>requireAdmin</code> — systemRole must be <code>admin</code> or <code>superuser</code></li>
    <li><code>requireSuperuser</code> — systemRole must be <code>superuser</code> only</li>
    <li><code>optionalAuth</code> — Attaches user if session exists, never fails</li>
  </ul>

  <h2>Full Session Lifecycle</h2>

  <p>
    The diagram below shows the complete flow from login through every authenticated request to logout,
    including the Vite dev proxy that sits between the React frontend and the Express backend.
  </p>

  <pre><code set:html={sessionLifecycle}></code></pre>

  <div class="info-box">
    <strong>Key design decision — <code>await saveSession()</code>:</strong>
    The session document is written to MongoDB <em>before</em> the login response is sent.
    This prevents the race condition where the frontend's immediate follow-up request
    (<code>/auth/me</code>) arrives before the session exists in the database,
    which would cause a spurious 401 and redirect the user back to login.
  </div>

  <h3>Cookie settings (development vs production)</h3>
  <table class="doc-table">
    <thead><tr><th>Attribute</th><th>Development</th><th>Production</th></tr></thead>
    <tbody>
      <tr><td><code>HttpOnly</code></td><td>true</td><td>true — never accessible via JavaScript</td></tr>
      <tr><td><code>Secure</code></td><td>false — HTTP allowed</td><td>true — HTTPS only</td></tr>
      <tr><td><code>SameSite</code></td><td>Lax</td><td>Strict</td></tr>
      <tr><td><code>MaxAge</code></td><td colspan="2">86 400 000 ms (24 hours); configurable via <code>SESSION_MAX_AGE</code> env var</td></tr>
    </tbody>
  </table>

  <h3>Vite dev proxy cookie rewriting</h3>
  <p>
    In development, the Vite proxy (<code>vite.config.js</code>) intercepts all
    <code>/api/*</code> requests from the React app and forwards them to <code>localhost:5001</code>.
    It also rewrites the <code>Set-Cookie</code> response headers to:
  </p>
  <ul>
    <li>Strip the <code>Secure</code> flag so the cookie works over plain HTTP</li>
    <li>Replace <code>SameSite=None</code> with <code>SameSite=Lax</code> if needed</li>
    <li>Set the cookie domain to blank so it binds to the browser's current host (<code>localhost</code>)</li>
  </ul>
  <p>
    The result: the browser stores <code>crm.sid</code> for <code>localhost</code> and
    automatically attaches it to every <code>/api/*</code> request, which the proxy
    then forwards — including the cookie — to the Express backend.
  </p>

  <h2>Registration Flow</h2>

  <pre><code set:html={registerFlow}></code></pre>

  <h3>Plan limits set on registration</h3>
  <table class="doc-table">
    <thead><tr><th>Plan</th><th>maxUsers</th><th>maxRecords</th><th>maxObjects</th></tr></thead>
    <tbody>
      <tr><td>Starter</td><td>1</td><td>5,000</td><td>10</td></tr>
      <tr><td>Basic</td><td>3</td><td>10,000</td><td>15</td></tr>
      <tr><td>Standard</td><td>10</td><td>50,000</td><td>30</td></tr>
      <tr><td>Enterprise</td><td>20</td><td>200,000</td><td>100</td></tr>
    </tbody>
  </table>

  <h2>Login Flow</h2>

  <pre><code set:html={loginFlow}></code></pre>

  <h2>API Key Authentication</h2>

  <p>
    Requests with an <code>X-API-Key</code> header bypass session auth and are authenticated
    via the <code>ApiKey</code> model. API keys are scoped, have optional IP whitelisting,
    and support per-object access restrictions.
  </p>

  <pre><code set:html={apiKeyCode}></code></pre>

  <h3>API Key features</h3>
  <ul>
    <li>Keys are stored as <code>bcrypt</code> hashes — the raw key is only shown once on creation</li>
    <li><code>allowedObjects</code>: restrict key to specific object API names (e.g. <code>["contact", "lead"]</code>)</li>
    <li><code>ipWhitelist</code>: restrict key to specific IP addresses</li>
    <li><code>expiresAt</code>: optional expiry date</li>
    <li>Usage is counted and logged to <code>ApiKeyUsageLog</code> after each request</li>
  </ul>

  <h2>Security Notes</h2>
  <ul>
    <li>Passwords hashed with <code>bcrypt</code> (10 rounds)</li>
    <li>Sessions use HTTP-only cookies — inaccessible to JavaScript</li>
    <li><code>sameSite: strict</code> in production (CSRF protection)</li>
    <li><code>secure: true</code> in production (HTTPS only)</li>
    <li>Failed login counter with account lockout after 5 attempts</li>
    <li>Rate limiting: 500 req / 15 min globally, 10 req / 15 min on login</li>
    <li>MongoDB session TTL auto-cleanup — no cron job needed</li>
    <li><code>express-mongo-sanitize</code> prevents NoSQL injection</li>
    <li><code>helmet</code> sets security headers on all responses</li>
  </ul>
</DevLayout>

