---
import DevLayout from '../../layouts/DevLayout.astro';

const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const sessionSchema = esc(`import mongoose from 'mongoose';

const sessionSchema = new mongoose.Schema({
  sessionId:      { type: String, required: true, unique: true, index: true },
  userId:         { type: mongoose.Schema.Types.ObjectId, ref: 'User', default: null },
  tenantId:       { type: mongoose.Schema.Types.ObjectId, ref: 'Tenant', default: null },
  workspaceId:    { type: mongoose.Schema.Types.ObjectId, ref: 'Workspace', default: null },
  data:           { type: mongoose.Schema.Types.Mixed, default: {} },
  expiresAt:      { type: Date, required: true, index: true },
  lastAccessedAt: { type: Date, default: Date.now },
  ipAddress:      { type: String },
  userAgent:      { type: String },
}, { timestamps: true });

// MongoDB TTL: auto-removes expired documents
sessionSchema.index({ expiresAt: 1 }, { expireAfterSeconds: 0 });
sessionSchema.index({ userId: 1 });

export default mongoose.model('Session', sessionSchema);`);

const middlewareCode = esc(`// backend/middleware/sessionMiddleware.js (abridged)
import { v4 as uuidv4 } from 'uuid';
import Session from '../models/Session.js';

const SESSION_COOKIE = 'crm.sid';
const SESSION_MAX_AGE = parseInt(process.env.SESSION_MAX_AGE) || 86400000; // 24 h

const sessionMiddleware = async (req, res, next) => {
  const sid = parseCookies(req.headers.cookie)[SESSION_COOKIE] || null;
  req.sessionId = null;
  req.sessionData = null;

  if (sid) {
    const session = await Session.findOne({ sessionId: sid, expiresAt: { $gt: new Date() } });
    if (session) {
      req.sessionId = sid;
      req.sessionData = {
        userId: session.userId?.toString() || null,
        tenantId: session.tenantId?.toString() || null,
        workspaceId: session.workspaceId?.toString() || null,
      };
    }
  }

  req.createSession = async (data) => {          // login / register
    const newSid = uuidv4();                       // opaque, unguessable id
    await Session.create({ sessionId: newSid, ...data,
      expiresAt: new Date(Date.now() + SESSION_MAX_AGE) });
    _setSessionCookie(res, newSid);
  };
  req.updateSession = async (updates) => { /* e.g. switch workspace */ };
  req.destroySession = async () => {            // logout
    await Session.deleteOne({ sessionId: req.sessionId });
    _clearSessionCookie(res);
  };
  next();
};`);

const cookieCode = esc(`const _setSessionCookie = (res, sid) => {
  const isProd = process.env.NODE_ENV === 'production';
  const parts = [
    \`crm.sid=\${encodeURIComponent(sid)}\`,
    'HttpOnly',
    'Path=/',
    \`Max-Age=\${Math.floor(SESSION_MAX_AGE / 1000)}\`,
    \`SameSite=\${isProd ? 'None' : 'Lax'}\`,
  ];
  if (isProd) parts.push('Secure'); // required for SameSite=None
  res.setHeader('Set-Cookie', parts.join('; '));
};`);

const authMiddleware = esc(`// backend/middleware/auth.js (abridged)
const requireAuth = async (req, res, next) => {
  try {
    // 1. API key (integrations)
    const apiKeyHeader = req.headers['x-api-key'];
    if (apiKeyHeader) return await authenticateApiKey(req, res, next, apiKeyHeader);

    // 2. Session — already loaded from MongoDB by sessionMiddleware
    if (!req.sessionData?.userId) throw new AppError('Authentication required. Please log in.', 401);

    // 3. User must exist, be active and not locked
    const user = await User.findById(req.sessionData.userId).populate('role');
    if (!user) { await req.destroySession(); throw new AppError('User not found. Session invalidated.', 401); }
    if (user.status !== 'active') throw new AppError('Your account has been deactivated.', 403);
    if (user.isLocked())          throw new AppError('Account temporarily locked.', 403);

    // 4. Tenant comes ONLY from the server-side session —
    //    a client-supplied X-Tenant-ID header is never trusted to set scope.
    const tenantId = req.sessionData.tenantId;
    if (!tenantId) throw new AppError('No active tenant. Please select a workspace.', 400);

    req.user = user;
    req.tenantId = tenantId.toString();
    Session.updateOne({ sessionId: req.sessionId }, { lastAccessedAt: new Date() }).catch(() => {});
    next();
  } catch (err) {
    next(err);
  }
};`);

const sessionLifecycle = esc(`
Browser (React app)                                   Backend (Express)
────────────────────────────────────────              ─────────────────────────────────────────

1. POST /api/v1/auth/login  (axios, withCredentials: true)
   ─────────────────────────────────────────────────► authController.login()
                                                        └─ verify password
                                                        └─ await req.createSession({ userId, tenantId })
                                                             └─ Session.create({ sessionId: uuid, ... })
   ◄──────────────── 200 { user, tenant } + Set-Cookie: crm.sid=<uuid>; HttpOnly; ...
   Browser stores crm.sid

2. GET /api/v1/auth/me      (Cookie: crm.sid=<uuid>, attached automatically)
   ─────────────────────────────────────────────────► sessionMiddleware
                                                        └─ Session.findOne({ sessionId, expiresAt > now })
                                                        └─ req.sessionData = { userId, tenantId, ... }
                                                      requireAuth
                                                        └─ User.findById(userId), active, not locked
                                                        └─ req.tenantId from the session only
   ◄─────────────────────────────────────────────────── 200 + user data

3. POST /api/v1/auth/logout
   ─────────────────────────────────────────────────► authController.logout()
                                                        └─ await req.destroySession()
                                                             └─ Session.deleteOne({ sessionId })
   ◄──────────────── 200 + Set-Cookie: crm.sid=; Max-Age=0
`);

const registerFlow = esc(`POST /api/v1/auth/register
─────────────────────────────────────────────
1. Validate: firstName, lastName, email, password, tenantName
2. Check tenantName uniqueness (case-insensitive)
3. Auto-generate tenantSlug from tenantName
4. Create Tenant document (with plan, phone, debitOrderDay)
5. seedDefaultRoles(tenant._id) → creates superuser/admin/user roles
6. Create User (systemRole: 'superuser', emailVerified: true)
7. await req.createSession({ userId, tenantId, userAgent, ipAddress })
8. Optionally kick off AI onboarding in background
9. Return { user, tenant }`);

const loginFlow = esc(`POST /api/v1/auth/login
─────────────────────────────────────────────
1. Find user by username (+ optional tenantId)
2. Check account not locked (failed login counter)
3. bcrypt.compare(password, user.password)
4. Check user.status === 'active'
5. Check tenant.status === 'active'
6. Reset failed login counter
7. await req.createSession({ userId, tenantId, userAgent, ipAddress })
   ↑ Writes the Session document to MongoDB BEFORE the response
     is sent, so the immediate /auth/me request always finds it.
8. Set-Cookie: crm.sid=<random-uuid>; HttpOnly; SameSite=Lax
   (SameSite=None; Secure in production)
9. Audit log: action 'login'
10. Return { user, tenant }`);

const apiKeyCode = esc(`// API Key authentication flow
const authenticateApiKey = async (req, res, next, rawKey) => {
  const prefix  = rawKey.substring(0, 12);
  const apiKeys = await ApiKey.find({ keyPrefix: prefix, isActive: true }).select('+keyHash');

  const validKey = apiKeys.find(k => k.verifyKey(rawKey));
  if (!validKey) throw new AppError('Invalid API key.', 401);
  if (validKey.expiresAt && validKey.expiresAt < new Date()) throw new AppError('API key expired.', 401);

  // IP whitelist check
  if (validKey.ipWhitelist?.length && !validKey.ipWhitelist.includes(req.ip)) {
    throw new AppError('IP not whitelisted.', 403);
  }

  const user = await User.findById(validKey.createdBy).populate('role');
  req.user        = user;
  req.tenantId    = validKey.tenantId.toString();
  req.apiKey      = validKey;
  req.isApiKeyAuth = true;

  // Update usage counter (non-blocking)
  ApiKey.updateOne({ _id: validKey._id }, { lastUsedAt: new Date(), $inc: { usageCount: 1 } }).catch(() => {});
  next();
};`);
---

<DevLayout
  title="Authentication — Developer Guide — Salesdam"
  description="How session authentication, the Session model, the session middleware and API key auth work in Salesdam."
>
  <h1>Authentication</h1>

  <p>
    Salesdam uses <strong>server-side session authentication</strong> backed by a custom
    <code>Session</code> Mongoose model — no third-party session store package is used.
    API keys provide an alternative authentication path for programmatic access.
  </p>

  <div class="info-box">
    <strong>Key decision:</strong> Sessions are managed by a small hand-written middleware,
    <code>backend/middleware/sessionMiddleware.js</code> — not <code>express-session</code> and
    not a session-store package. The <code>crm.sid</code> cookie carries an opaque, random
    session id (a UUID); everything else lives in the <code>Session</code> collection. Nothing is
    signed, so there is no session secret to configure: an unknown or expired id simply
    finds no session.
  </div>

  <h2>Session Model — <code>backend/models/Session.js</code></h2>

  <p>Each active session is a MongoDB document, removed automatically when it expires:</p>

  <pre><code set:html={sessionSchema}></code></pre>

  <h3>Session Fields</h3>
  <table class="doc-table">
    <thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td><code>sessionId</code></td><td>String</td><td>Random UUID, also the <code>crm.sid</code> cookie value; unique, indexed</td></tr>
      <tr><td><code>userId</code></td><td>ObjectId → User</td><td>The signed-in user</td></tr>
      <tr><td><code>tenantId</code></td><td>ObjectId → Tenant</td><td>Active tenant — the only source of tenant scope for the request</td></tr>
      <tr><td><code>workspaceId</code></td><td>ObjectId → Workspace</td><td>Last workspace chosen with <code>POST /workspaces/switch</code></td></tr>
      <tr><td><code>data</code></td><td>Mixed</td><td>Spare payload (currently unused)</td></tr>
      <tr><td><code>expiresAt</code></td><td>Date</td><td>Expiry; a MongoDB TTL index deletes expired documents</td></tr>
      <tr><td><code>lastAccessedAt</code></td><td>Date</td><td>Updated on each authenticated request</td></tr>
      <tr><td><code>ipAddress</code></td><td>String</td><td>Client IP at sign-in, for auditing</td></tr>
      <tr><td><code>userAgent</code></td><td>String</td><td>Browser / client identifier</td></tr>
    </tbody>
  </table>

  <h2>Session Middleware — <code>backend/middleware/sessionMiddleware.js</code></h2>

  <p>
    Runs on every request. It reads the cookie, loads the matching unexpired session and
    attaches <code>req.sessionData</code>, plus three helpers the auth controller uses.
  </p>

  <pre><code set:html={middlewareCode}></code></pre>

  <h3>Helpers attached to each request</h3>
  <table class="doc-table">
    <thead><tr><th>Helper</th><th>Used by</th><th>What it does</th></tr></thead>
    <tbody>
      <tr><td><code>req.createSession(data)</code></td><td>Login, registration</td><td>Creates the Session document with a new UUID and sets the cookie</td></tr>
      <tr><td><code>req.updateSession(updates)</code></td><td>Workspace switch</td><td>Patches the current session document</td></tr>
      <tr><td><code>req.destroySession()</code></td><td>Logout, invalid user</td><td>Deletes the Session document and clears the cookie</td></tr>
    </tbody>
  </table>

  <h2>Session Cookie</h2>

  <pre><code set:html={cookieCode}></code></pre>

  <table class="doc-table">
    <thead><tr><th>Attribute</th><th>Development</th><th>Production</th></tr></thead>
    <tbody>
      <tr><td><code>HttpOnly</code></td><td>yes</td><td>yes — never readable from JavaScript</td></tr>
      <tr><td><code>Secure</code></td><td>no — HTTP allowed</td><td>yes — HTTPS only</td></tr>
      <tr><td><code>SameSite</code></td><td>Lax</td><td>None (with <code>Secure</code>), so it also works when the app and API are on different sites</td></tr>
      <tr><td><code>Max-Age</code></td><td colspan="2">24 hours by default; set <code>SESSION_MAX_AGE</code> (milliseconds) to change it</td></tr>
    </tbody>
  </table>

  <h2>Authentication Middleware — <code>backend/middleware/auth.js</code></h2>

  <p>
    <code>requireAuth</code> is applied to all protected routes. It checks for an API key header
    first, then uses the session loaded by the session middleware.
  </p>

  <pre><code set:html={authMiddleware}></code></pre>

  <h3>Exported middleware</h3>
  <ul>
    <li><code>requireAuth</code> — Any authenticated user (session or API key)</li>
    <li><code>requireAdmin</code> — the user's role must be <code>admin</code> or <code>superuser</code></li>
    <li><code>requireSuperuser</code> — the user's role must be <code>superuser</code></li>
    <li><code>optionalAuth</code> — Attaches the user if a session exists, never fails</li>
  </ul>

  <h2>Full Session Lifecycle</h2>

  <p>From sign-in, through an authenticated request, to sign-out:</p>

  <pre><code set:html={sessionLifecycle}></code></pre>

  <div class="info-box">
    <strong>The session exists before the login response is sent.</strong>
    <code>createSession</code> awaits the MongoDB write, so the app's immediate follow-up
    request (<code>/auth/me</code>) always finds it — no spurious 401 straight after signing in.
  </div>

  <h2>Frontend and API origins</h2>
  <p>
    There is no development proxy. The React app calls the API at
    <code>VITE_API_URL</code> (e.g. <code>http://localhost:5000</code>) and appends
    <code>/api/v1</code>, sending the cookie with <code>withCredentials: true</code>.
  </p>
  <ul>
    <li><strong>Development:</strong> the app on <code>localhost:5173</code> and the API on
      <code>localhost:5000</code> are the same site (ports don't count), so the <code>Lax</code>
      cookie is sent. The backend must allow the app's origin in <code>CORS_ORIGINS</code>,
      with credentials.</li>
    <li><strong>Production:</strong> either serve the API under the app's own domain (the
      Render configuration rewrites <code>/api/*</code> to the API service, so the cookie is
      first-party), or call the API on its own domain — which is what <code>SameSite=None</code>
      plus <code>Secure</code> allows, with <code>CORS_ORIGINS</code> set to the app's origin.</li>
  </ul>

  <h2>Registration Flow</h2>

  <pre><code set:html={registerFlow}></code></pre>

  <h3>Plan limits set on registration</h3>
  <table class="doc-table">
    <thead><tr><th>Plan</th><th>maxUsers</th><th>maxRecords</th><th>maxObjects</th></tr></thead>
    <tbody>
      <tr><td>Starter</td><td>1</td><td>5,000</td><td>10</td></tr>
      <tr><td>Basic</td><td>3</td><td>10,000</td><td>15</td></tr>
      <tr><td>Standard</td><td>10</td><td>50,000</td><td>30</td></tr>
      <tr><td>Enterprise</td><td>20</td><td>200,000</td><td>100</td></tr>
    </tbody>
  </table>

  <h2>Login Flow</h2>

  <pre><code set:html={loginFlow}></code></pre>

  <h2>API Key Authentication</h2>

  <p>
    Requests with an <code>X-API-Key</code> header bypass session auth and are authenticated
    via the <code>ApiKey</code> model. API keys are scoped, have optional IP whitelisting,
    and support per-object access restrictions.
  </p>

  <pre><code set:html={apiKeyCode}></code></pre>

  <h3>API Key features</h3>
  <ul>
    <li>Keys are stored as <code>bcrypt</code> hashes — the raw key is only shown once on creation</li>
    <li><code>allowedObjects</code>: restrict key to specific object API names (e.g. <code>["contact", "lead"]</code>)</li>
    <li><code>ipWhitelist</code>: restrict key to specific IP addresses</li>
    <li><code>expiresAt</code>: optional expiry date</li>
    <li>Usage is counted and logged to <code>ApiKeyUsageLog</code> after each request</li>
  </ul>

  <h2>Security Notes</h2>
  <ul>
    <li>Passwords hashed with <code>bcrypt</code> (10 rounds)</li>
    <li>Sessions use HTTP-only cookies — inaccessible to JavaScript</li>
    <li><code>sameSite: strict</code> in production (CSRF protection)</li>
    <li><code>secure: true</code> in production (HTTPS only)</li>
    <li>Failed login counter with account lockout after 5 attempts</li>
    <li>Rate limiting: 500 req / 15 min globally, 10 req / 15 min on login</li>
    <li>MongoDB session TTL auto-cleanup — no cron job needed</li>
    <li><code>express-mongo-sanitize</code> prevents NoSQL injection</li>
    <li><code>helmet</code> sets security headers on all responses</li>
  </ul>
</DevLayout>

