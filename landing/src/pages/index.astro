---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PlanCard from '../components/PlanCard.astro';
import { APP_URL } from '../config';
import { Target, Zap, BarChart3, Users, Shield, RefreshCw, Mail, Sparkles } from 'lucide-astro';
---

<BaseLayout
  title="Salesdam — Multi-tenant CRM & Insurance Platform"
  description="Build powerful customer relationships with Salesdam. Custom objects, automation, analytics, and AI onboarding. Start building in minutes."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">CRM and Insurance Workspace on One Platform</h1>
          <p class="hero-subtitle">
            Salesdam is a multi-tenant CRM with a configurable data model — custom objects,
            fields, validations and formulas — plus approval workflows, duplicate management
            and a documented REST API. On top of that sits a full insurance workspace: new
            business, policy servicing, premium billing and claims.
          </p>
          <div class="hero-buttons">
            <a href={APP_URL + '/login'} class="btn btn-primary btn-large">Sign in</a>
            <a href="#features" class="btn btn-secondary btn-large">See what it does</a>
          </div>
          <p class="hero-note">Objects, fields, workflows and permissions are configured — not hard-coded.</p>
        </div>
      </div>
    </section>

    <!-- What it is Section -->
    <section class="section social-proof">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value stat-value-text">Multi-tenant</div>
            <div class="stat-label">Every query is scoped to the organisation that owns it</div>
          </div>
          <div class="stat-card">
            <div class="stat-value stat-value-text">Configurable</div>
            <div class="stat-label">Objects, fields, validations and formulas defined per tenant</div>
          </div>
          <div class="stat-card">
            <div class="stat-value stat-value-text">Governed</div>
            <div class="stat-label">Role, object and field-level permissions, with a full audit trail</div>
          </div>
          <div class="stat-card">
            <div class="stat-value stat-value-text">Documented</div>
            <div class="stat-label">REST API, API keys, webhooks and product documentation</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="section features" id="features">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Platform Features</span>
          <h2 class="section-title">Everything You Need to Manage Customer Relationships</h2>
          <p class="section-subtitle">
            Salesdam combines powerful features with intuitive design, giving you the tools
            to customize your CRM exactly how you need it.
          </p>
        </div>

        <div class="features-grid">
          <FeatureCard
            title="Custom Objects & Fields"
            description="Build your data model with custom objects, fields, and relationships. Support for text, number, date, lookup, master-detail, and more field types."
            iconColor="#0066FF"
          >
            <Target slot="icon" size={28} strokeWidth={2} />
          </FeatureCard>
          <FeatureCard
            title="Automation Flows"
            description="Design visual automation workflows with triggers, conditions, and actions. Automate record creation, updates, emails, and webhooks."
            iconColor="#f59e0b"
          >
            <Zap slot="icon" size={28} strokeWidth={2} />
          </FeatureCard>
          <FeatureCard
            title="Analytics & Dashboards"
            description="Create interactive dashboards with charts, metrics, and tables. Real-time insights into your business with customizable widgets."
            iconColor="#6366f1"
          >
            <BarChart3 slot="icon" size={28} strokeWidth={2} />
          </FeatureCard>
          <FeatureCard
            title="Multi-Tenant Workspaces"
            description="Isolated workspaces for each customer with complete data separation. Perfect for SaaS applications and agencies."
            iconColor="#10b981"
          >
            <Users slot="icon" size={28} strokeWidth={2} />
          </FeatureCard>
          <FeatureCard
            title="Role-Based Access Control"
            description="Define custom roles with granular permissions. Control who can view, create, edit, and delete records at the field level."
            iconColor="#9333ea"
          >
            <Shield slot="icon" size={28} strokeWidth={2} />
          </FeatureCard>
          <FeatureCard
            title="API & Integrations"
            description="RESTful API with authentication tokens. Connect to external systems with webhooks, API calls, and custom integrations."
            iconColor="#0891b2"
          >
            <RefreshCw slot="icon" size={28} strokeWidth={2} />
          </FeatureCard>
          <FeatureCard
            title="Email Templates"
            description="Design beautiful email templates with dynamic field merging. Send automated emails based on workflow triggers."
            iconColor="#ec4899"
          >
            <Mail slot="icon" size={28} strokeWidth={2} />
          </FeatureCard>
          <FeatureCard
            title="AI-Powered Onboarding"
            description="Get started quickly with AI-assisted workspace setup. Generate sample data, objects, and workflows automatically."
            iconColor="#f97316"
          >
            <Sparkles slot="icon" size={28} strokeWidth={2} />
          </FeatureCard>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="section how-it-works">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Simple Setup</span>
          <h2 class="section-title">How It Works</h2>
          <p class="section-subtitle">Get up and running in minutes with our intuitive setup process</p>
        </div>

        <div class="steps-grid">
          <div class="step">
            <div class="step-number">1</div>
            <h3>Create Your Workspace</h3>
            <p>Sign up and create your multi-tenant workspace. Set your workspace name and configure basic settings.</p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <h3>Build Your Objects</h3>
            <p>Use the visual schema builder to create custom objects and fields. Define relationships and validation rules.</p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <h3>Add Your Team</h3>
            <p>Invite users and assign roles. Configure permissions to control access to objects and records.</p>
          </div>
          <div class="step">
            <div class="step-number">4</div>
            <h3>Automate & Analyze</h3>
            <p>Build automation flows and create dashboards. Let Salesdam work for you while you focus on customers.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="section pricing" id="pricing">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Licensing</span>
          <h2 class="section-title">Annual Licensing, Priced Per User</h2>
          <p class="section-subtitle">
            Salesdam is licensed per user, per year. Configuration, data migration and
            integration work are scoped to your business, so we quote those separately.
          </p>
        </div>

        <div class="pricing-grid">
          <div class="plan-card">
            <h3 class="plan-name">What's included</h3>
            <ul class="plan-features">
              <li>The full CRM: objects, fields, list views, dashboards, reports</li>
              <li>Approval workflows, duplicate rules, record merge and audit trail</li>
              <li>The insurance workspace, if you need it</li>
              <li>REST API, API keys, webhooks and documentation</li>
              <li>Hosting, upgrades and support</li>
            </ul>
            <a href="/contact" class="btn btn-primary btn-large">Request a quote</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Who it is for Section -->
    <section class="section testimonials">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Where it fits</span>
          <h2 class="section-title">Built for Teams That Outgrew a Spreadsheet</h2>
          <p class="section-subtitle">
            The same platform covers a client book, a sales pipeline and a policy book.
          </p>
        </div>

        <div class="testimonials-grid">
          <div class="testimonial">
            <h3 class="testimonial-title">Insurance providers</h3>
            <p class="testimonial-text">
              Take a policy from application through quote, acceptance and issue, then service
              it: lapse, reinstate, suspend, cancel, endorse, bill the premium and pay claims.
            </p>
          </div>
          <div class="testimonial">
            <h3 class="testimonial-title">Agencies and consultancies</h3>
            <p class="testimonial-text">
              Give every client their own workspace and their own data model inside one
              installation, with roles deciding who sees what.
            </p>
          </div>
          <div class="testimonial">
            <h3 class="testimonial-title">B2B sales teams</h3>
            <p class="testimonial-text">
              Leads, deals, orders, quotes and invoices with approvals where you need them,
              dashboards over the pipeline, and tender opportunities tracked alongside.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-content">
          <h2>Ready to See Salesdam in Action?</h2>
          <p>Sign in to the platform, or ask us to walk you through a workspace end to end.</p>
          <div class="cta-buttons">
            <a href={APP_URL + '/login'} class="btn btn-primary btn-large">Sign in</a>
            <a href="/contact" class="btn btn-secondary btn-large">Talk to us</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    padding: 140px 0 100px;
    background: linear-gradient(135deg, #0066FF 0%, #0052CC 100%);
    color: white;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(255,255,255,0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    margin-bottom: 24px;
    line-height: 1.1;
    font-weight: 800;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    margin-bottom: 40px;
    opacity: 0.95;
    line-height: 1.7;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-bottom: 16px;
  }

  .btn-large {
    padding: 16px 32px;
    font-size: 1.1rem;
  }

  .hero-note {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  /* Social Proof Section */
  .social-proof {
    background: white;
    padding: 60px 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .stat-card {
    text-align: center;
    padding: 24px;
    background: var(--bg);
    border-radius: 12px;
    border: 1px solid var(--border);
    transition: all 0.25s ease;
  }

  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 8px;
  }

  /* Words rather than figures — a smaller size keeps them on one line. */
  .stat-value-text {
    font-size: 1.4rem;
    line-height: 1.25;
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Features Section */
  .features {
    background: white;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
  }

  /* How It Works */
  .how-it-works {
    background: var(--bg);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
  }

  .step {
    text-align: center;
  }

  .step-number {
    width: 64px;
    height: 64px;
    background: var(--primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    margin: 0 auto 24px;
  }

  .step h3 {
    font-size: 1.5rem;
    margin-bottom: 12px;
    color: var(--text);
  }

  .step p {
    color: var(--text-secondary);
  }

  /* Pricing Section */
  .pricing {
    background: white;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Testimonials */
  .testimonials {
    background: var(--bg);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
  }

  .testimonial {
    background: white;
    padding: 32px;
    border-radius: 12px;
    box-shadow: var(--shadow);
  }

  .testimonial-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }

  .testimonial-text {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 24px;
    font-style: italic;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
  }

  .testimonial-author strong {
    color: var(--text);
    margin-bottom: 4px;
  }

  .testimonial-author span {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* CTA Section */
  .cta-section {
    background: linear-gradient(135deg, #0066FF 0%, #0052CC 100%);
    color: white;
  }

  .cta-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-size: 2.5rem;
    margin-bottom: 16px;
  }

  .cta-content p {
    font-size: 1.25rem;
    margin-bottom: 32px;
    opacity: 0.95;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: 120px 0 80px;
    }

    .hero-buttons,
    .cta-buttons {
      flex-direction: column;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .features-grid,
    .pricing-grid,
    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .steps-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
