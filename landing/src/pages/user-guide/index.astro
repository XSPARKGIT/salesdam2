---
import DocsLayout from '../../layouts/DocsLayout.astro';
import {
  Target,
  FileText,
  Zap,
  LayoutDashboard,
  Users,
  RefreshCw,
  TrendingUp,
  ArrowRight,
  BookOpen,
  HelpCircle,
} from 'lucide-astro';
---

<DocsLayout
  title="User Guide - Salesdam"
  description="Complete guide to using Salesdam features"
>
  <!-- <div class="hero-section">
    <div class="hero-icon-wrap">
      <BookOpen size={32} />
    </div>
    <h1>User Guide</h1>
    <p class="hero-lead">
      Welcome to the Salesdam User Guide. This comprehensive documentation
      covers all features and functionality of the platform. Whether you're just
      getting started or looking to master advanced features, you'll find
      everything you need here.
    </p>
  </div> -->

  <div class="section-header">
    <h2>What You'll Learn</h2>
    <p>
      This guide is organized by feature area, making it easy to find the
      information you need. Each section includes step-by-step instructions,
      best practices, and real-world examples.
    </p>
  </div>

  <div class="guide-grid">
    <a href="/user-guide/objects" class="guide-card">
      <div class="guide-icon-wrap">
        <Target size={24} />
      </div>
      <div class="guide-card-body">
        <h3>Object Settings</h3>
        <p>
          Learn how to create custom objects, add fields, configure
          relationships, and use the visual schema builder to design your data
          model.
        </p>
      </div>
      <div class="guide-card-footer">
        <span class="guide-link-text">Read section</span>
        <ArrowRight size={16} class="guide-arrow" />
      </div>
    </a>

    <a href="/user-guide/records" class="guide-card">
      <div class="guide-icon-wrap">
        <FileText size={24} />
      </div>
      <div class="guide-card-body">
        <h3>Records</h3>
        <p>
          Master record creation, editing, viewing, and deletion. Learn about
          related lists, attachments, and bulk operations.
        </p>
      </div>
      <div class="guide-card-footer">
        <span class="guide-link-text">Read section</span>
        <ArrowRight size={16} class="guide-arrow" />
      </div>
    </a>

    <a href="/user-guide/automation" class="guide-card">
      <div class="guide-icon-wrap">
        <Zap size={24} />
      </div>
      <div class="guide-card-body">
        <h3>Automation</h3>
        <p>
          Build powerful automation flows with triggers, conditions, and
          actions. Automate emails, record updates, and integrations.
        </p>
      </div>
      <div class="guide-card-footer">
        <span class="guide-link-text">Read section</span>
        <ArrowRight size={16} class="guide-arrow" />
      </div>
    </a>

    <a href="/user-guide/dashboards" class="guide-card">
      <div class="guide-icon-wrap">
        <LayoutDashboard size={24} />
      </div>
      <div class="guide-card-body">
        <h3>Dashboards</h3>
        <p>
          Create interactive dashboards with charts, metrics, and tables. Share
          insights with your team and track KPIs.
        </p>
      </div>
      <div class="guide-card-footer">
        <span class="guide-link-text">Read section</span>
        <ArrowRight size={16} class="guide-arrow" />
      </div>
    </a>

    <a href="/user-guide/users-roles" class="guide-card">
      <div class="guide-icon-wrap">
        <Users size={24} />
      </div>
      <div class="guide-card-body">
        <h3>Users &amp; Roles</h3>
        <p>
          Manage team members, create custom roles, and configure permissions.
          Control access at the object and field level.
        </p>
      </div>
      <div class="guide-card-footer">
        <span class="guide-link-text">Read section</span>
        <ArrowRight size={16} class="guide-arrow" />
      </div>
    </a>

    <a href="/user-guide/integrations" class="guide-card">
      <div class="guide-icon-wrap">
        <RefreshCw size={24} />
      </div>
      <div class="guide-card-body">
        <h3>Integrations</h3>
        <p>
          Connect Salesdam to external systems with API keys, webhooks, and
          external objects. Build custom integrations.
        </p>
      </div>
      <div class="guide-card-footer">
        <span class="guide-link-text">Read section</span>
        <ArrowRight size={16} class="guide-arrow" />
      </div>
    </a>

    <a href="/user-guide/analytics" class="guide-card">
      <div class="guide-icon-wrap">
        <TrendingUp size={24} />
      </div>
      <div class="guide-card-body">
        <h3>Analytics</h3>
        <p>
          Explore the analytics page, create reports, build charts, and analyze
          your data to make informed decisions.
        </p>
      </div>
      <div class="guide-card-footer">
        <span class="guide-link-text">Read section</span>
        <ArrowRight size={16} class="guide-arrow" />
      </div>
    </a>
  </div>

  <div class="content-section">
    <h2>Getting Started</h2>
    <p>
      If you're new to Salesdam, we recommend starting with our
      <a href="/getting-started">Getting Started Guide</a>. It walks you through
      the initial setup process and helps you create your first objects,
      records, and automation flows.
    </p>
  </div>

  <div class="help-panel">
    <div class="help-panel-icon">
      <HelpCircle size={22} />
    </div>
    <div class="help-panel-content">
      <h2>Need Help?</h2>
      <p>
        Can't find what you're looking for? Here are some additional resources:
      </p>
      <ul>
        <li>
          Check the <a href="/getting-started">Getting Started Guide</a> for setup
          instructions
        </li>
        <li>
          Visit the <a href="/developer">Developer Guide</a> for technical documentation
        </li>
        <li>
          Contact support at <a href="mailto:support@minicrm.com"
            >support@minicrm.com</a
          >
        </li>
        <li>Join our community forum for tips and discussions</li>
      </ul>
    </div>
  </div>

  <div class="content-section">
    <h2>Updates and Changes</h2>
    <p>
      This documentation is regularly updated to reflect new features and
      improvements. Check back frequently or subscribe to our changelog to stay
      informed about updates.
    </p>
  </div>
</DocsLayout>

<style>
  /* Hero */
  .hero-section {
    margin-bottom: 48px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--border);
  }

  .hero-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: var(--primary-light, rgba(59, 130, 246, 0.1));
    color: var(--primary);
    margin-bottom: 20px;
  }

  .hero-section h1 {
    margin: 0 0 16px 0;
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.2;
  }

  .hero-lead {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 680px;
    margin: 0;
  }

  /* Section headers */
  .section-header {
    margin-bottom: 8px;
  }

  .section-header h2,
  .content-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 10px 0;
    letter-spacing: -0.01em;
  }

  .section-header p,
  .content-section p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .content-section {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  /* Grid */
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin: 32px 0 0;
  }

  /* Cards */
  .guide-card {
    background: var(--bg);
    padding: 24px;
    border-radius: 14px;
    border: 1.5px solid var(--border);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    color: inherit;
  }

  .guide-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg, 0 12px 32px rgba(0, 0, 0, 0.1));
    border-color: var(--primary);
  }

  .guide-card:hover .guide-arrow {
    transform: translateX(4px);
  }

  .guide-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 11px;
    background: var(--primary-light, rgba(59, 130, 246, 0.1));
    color: var(--primary);
    flex-shrink: 0;
  }

  .guide-card-body {
    flex: 1;
  }

  .guide-card-body h3 {
    margin: 0 0 8px 0;
    color: var(--text);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .guide-card-body p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 0;
  }

  .guide-card-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--primary);
    padding-top: 4px;
    border-top: 1px solid var(--border);
  }

  .guide-link-text {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--primary);
  }

  .guide-arrow {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  /* Help panel */
  .help-panel {
    display: flex;
    gap: 20px;
    margin-top: 48px;
    padding: 28px;
    background: var(--bg-secondary, var(--bg));
    border: 1.5px solid var(--border);
    border-radius: 14px;
  }

  .help-panel-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--primary-light, rgba(59, 130, 246, 0.1));
    color: var(--primary);
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 2px;
  }

  .help-panel-content h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }

  .help-panel-content p {
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0 0 16px 0;
  }

  .help-panel-content ul {
    margin: 0;
    padding-left: 20px;
    color: var(--text-secondary);
    line-height: 1.9;
  }

  .help-panel-content li {
    font-size: 0.95rem;
  }

  /* Links */
  a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  a:hover {
    color: var(--primary-dark, var(--primary));
    text-decoration: underline;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .hero-section h1 {
      font-size: 1.9rem;
    }

    .hero-lead {
      font-size: 1rem;
    }

    .guide-grid {
      grid-template-columns: 1fr;
    }

    .help-panel {
      flex-direction: column;
      gap: 14px;
    }

    .help-panel-icon {
      align-self: flex-start;
    }
  }
</style>
