{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "backend",
      "port": 5002
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "admin",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:5002",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "cwd": "admin",
      "port": 5174
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4321"
      ],
      "cwd": "landing",
      "port": 4321
    },
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4322"
      ],
      "cwd": "docs",
      "port": 4322
    }
  ]
}
