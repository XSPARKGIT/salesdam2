NODE_ENV=development
PORT=5000

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MongoDB
MONGO_URI=mongodb://localhost:27017/salesdam

# Session
# Sessions are an opaque id in the crm.sid cookie, looked up in MongoDB — no
# signing secret is involved (see backend/middleware/sessionMiddleware.js).
SESSION_MAX_AGE=86400000

# Redis (optional - for BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-secure-random-value

# OpenAI (for AI onboarding)
OPENAI_API_KEY=replace-with-a-secure-random-value

# Email (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=replace-with-a-secure-random-value
SMTP_FROM=noreply@salesdam.com

# App
# APP_URL is the frontend (what links in emails point at) — the Vite dev
# server runs on 5173 (see frontend/vite.config.js).
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Admin Dashboard - Allowed superuser usernames (comma-separated)
# Only users listed here can log in to the admin dashboard
# Example: admin,gugulethu,john_doe
ADMIN_SUPERUSERS=admin@example.com

# Encryption
ENCRYPTION_KEY=replace-with-a-secure-random-value

# eTenders API
ETENDERS_API_URL=https://ocds-api.etenders.gov.za/api

# Paystack
PAYSTACK_SECRET_KEY=replace-with-a-secure-random-value
PAYSTACK_BASE_URL=https://api.paystack.co
# Plan Code Mapping Configuration
# Maps Paystack plan codes to internal plan tiers (starter, basic, standard, professional, enterprise)
# Format: PLAN_CODE_MAPPING=PLN_code1:tier1,PLN_code2:tier2,PLN_code3:tier3
# Example:
PLAN_CODE_MAPPING=PLN_m1ykgpo58lqzkqd:standard

# Enable/Disable Paystack checkout during registration
# Set to 'false' to allow only free plan registration (no payment required)
# When false: Users register instantly without email verification or checkout
# When true or omitted: Users register with plan selection and Paystack payment
# Default: true (Paystack enabled)
ENABLE_PAYSTACK_CHECKOUT=true
