{
  "name": "salesforce-mini-backend",
  "version": "3.3.0",
  "type": "module",
  "description": "Multi-tenant CRM backend - MERN stack",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:memory": "node dev-server.js",
    "dev:memory:watch": "nodemon --watch . --ignore node_modules dev-server.js",
    "db:up": "docker compose up -d --wait mongodb",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongodb",
    "seed": "node scripts/seed.js",
    "seed:local": "node scripts/seed-local.js",
    "seed:insurance": "node scripts/seed-insurance-objects.js",
    "test:insurance": "node tests/insurance-metadata.e2e.mjs && node tests/insurance-application.e2e.mjs && node tests/insurance-servicing-claims.e2e.mjs && node --test tests/insurance-billing.test.mjs && node --test tests/insurance-communication-templates.test.mjs && node tests/insurance-auto-lapse.e2e.mjs && node tests/insurance-billing-run.e2e.mjs && node tests/insurance-reinstatement.e2e.mjs && node tests/insurance-approval.e2e.mjs && node tests/insurance-documents.e2e.mjs && node tests/insurance-communication-triggers.e2e.mjs && node tests/insurance-communications.e2e.mjs && node tests/insurance-scheduler.e2e.mjs",
    "test:demo": "node tests/insurance-metadata.e2e.mjs && node tests/insurance-application.e2e.mjs && node tests/insurance-servicing-claims.e2e.mjs && node tests/insurance-scheduler.e2e.mjs && node tests/approval-process.e2e.mjs && node tests/duplicate-detection.e2e.mjs && node tests/record-merge.e2e.mjs && node tests/activity.e2e.mjs && node tests/tenant-isolation.e2e.mjs",
    "auto:lapse": "node scripts/run-auto-lapse.js",
    "billing:run": "node scripts/run-billing-cycle.js",
    "scheduler:run": "node scripts/run-insurance-scheduler.js",
    "communications:dispatch": "node scripts/dispatch-communications.js",
    "seed:support-docs": "node scripts/seed-support-documents.js",
    "create-indexes": "node scripts/createIndexes.js",
    "migrate:field-flags": "node scripts/migrateFieldFlags.js",
    "migrate:formula-return-types": "node scripts/backfillFormulaReturnTypes.js",
    "migrate:line-item-rollups": "node scripts/migrate-line-item-rollups.js",
    "migrate:list-view-fields": "node scripts/migrateListViewFields.js",
    "migrate:merge-fields": "node scripts/migrateMergeFields.js",
    "migrate:merge-fields-data": "node scripts/migrateMergeFieldsData.js",
    "migrate:approval-readonly": "node scripts/makeApprovalStatusReadOnly.js",
    "migrate:product-type": "node scripts/migrateProjectTypeToProductType.js",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "docx": "^9.10.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "mongoose": "^8.23.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.3",
    "openai": "^4.104.0",
    "sanitize-html": "^2.18.1",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.3"
  },
  "allowScripts": {
    "mongodb-memory-server@11.2.0": true,
    "msgpackr-extract@3.0.4": true
  }
}
