# Salesdam Insurance Workspace - Production Environment
# Copy to /etc/salesdam/environment and fill in values

# Database
MONGO_URI=mongodb://localhost:27017/salesdam?replicaSet=rs0

# Server
NODE_ENV=production
PORT=5002
CORS_ORIGINS=https://salesdam.example.com

# Session
# Sessions are an opaque id in the crm.sid cookie, looked up in MongoDB — no
# signing secret is involved (see backend/middleware/sessionMiddleware.js).
SESSION_MAX_AGE=86400000

# SMTP (for email delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Salesdam Insurance <noreply@example.com>"

# Frontend URL (for email links)
APP_URL=https://salesdam.example.com

# External integrations (fill in when available)
EUHORIA_API_KEY=
EUHORIA_API_SECRET=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
PAY_AT_MERCHANT_ID=
PAY_AT_PASSWORD=
EASYPAY_MERCHANT_ID=
EASYPAY_PASSWORD=
PAYMENT_GATEWAY_API_KEY=
UNDERWRITER_API_ENDPOINT=
UNDERWRITER_API_KEY=